{
  "manifestVersion": 1,
  "id": "org.stor.calc",
  "package": "@hearthlog/module-calc",
  "version": "1.0.11",
  "compatibility": {
    "moduleApi": 1
  },
  "features": [
    {
      "id": "calc",
      "path": "/calc",
      "label": "Calculator",
      "subtitle": "Income and date calculations",
      "keywords": "calc calculator tax income date days",
      "navGroup": "Money",
      "icon": "calculator-variant-outline",
      "navOrder": 30,
      "children": [
        {
          "id": "income",
          "label": "Income",
          "href": "/calc"
        },
        {
          "id": "dates",
          "label": "Dates",
          "href": "/calc/dates"
        }
      ]
    }
  ],
  "routes": [
    {
      "path": "/calc",
      "page": "./src/pages/income.svelte",
      "load": "./src/pages/income.ts"
    },
    {
      "path": "/calc/dates",
      "page": "./src/pages/dates.svelte"
    }
  ]
}
